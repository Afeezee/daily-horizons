{
  "name": "SavedArticle",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string",
      "description": "ID of the saved article"
    },
    "folder": {
      "type": "string",
      "enum": [
        "read_later",
        "research",
        "favourite"
      ],
      "default": "read_later",
      "description": "Organization folder"
    }
  },
  "required": [
    "article_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}