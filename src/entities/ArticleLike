{
  "name": "ArticleLike",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string",
      "description": "ID of the liked article"
    },
    "reaction_type": {
      "type": "string",
      "enum": [
        "like",
        "insightful",
        "disagree",
        "applaud"
      ],
      "default": "like",
      "description": "Type of reaction"
    }
  },
  "required": [
    "article_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}